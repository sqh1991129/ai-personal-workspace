VUE_APP_TITLE=个人 AI 工作台
VUE_APP_API_BASE=/api
VUE_APP_API_TIMEOUT=15000
VUE_APP_DEV_PORT=8080
VUE_APP_API_PROXY_TARGET=http://127.0.0.1:8000
# 登录已对接真实后端（POST /api/v1/users/userLogin，见 docs/默认模块.md）。
# 后端没起或想回到 admin / admin 演示模式时改成 true，业务代码不用动。
VUE_APP_MOCK_AUTH=false
# 后端 /chat/* 与 /kb/* 未实现：true 走本地假数据（含假流式与假索引队列），false 走真实请求
VUE_APP_MOCK_API=true
